# Copier ce fichier vers `.env` puis adapter les valeurs (ne jamais committer .env).
# La base est toujours une base SQL via SQLAlchemy/Flask-SQLAlchemy.

# Secret de session (obligatoire en production).
SECRET_KEY=remplacez-par-une-valeur-longue-et-aleatoire

# Choix du moteur SQL. Exemples :
#   SQLite local (défaut si la variable est absente) :
DATABASE_URL=sqlite:///pert_cpm.db
#   PostgreSQL (Render fournit souvent postgres://, normalisé automatiquement) :
# DATABASE_URL=postgresql://utilisateur:motdepasse@hote:5432/base
#   MySQL / MariaDB (pilote PyMySQL inclus dans requirements.txt) :
# DATABASE_URL=mysql://utilisateur:motdepasse@hote:3306/base

# Selection de la configuration Flask (défaut : config.Config).
# APP_SETTINGS=config.ProductionConfig

# Verification de l'e-mail (activee par defaut en production).
# EMAIL_VERIFICATION_ENABLED=1

# SMTP (optionnel : sans serveur, le code est affiche en developpement).
# MAIL_SERVER=smtp.example.com
# MAIL_PORT=587
# MAIL_USE_TLS=1
# MAIL_USERNAME=utilisateur
# MAIL_PASSWORD=motdepasse
# MAIL_DEFAULT_SENDER=PERT/CPM <no-reply@example.com>
